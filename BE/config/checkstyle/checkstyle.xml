<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  yeolsal BE Checkstyle configuration (Story 1.5 AC4 Option A, Arch 4.15 BE-side complement).

  Goal: block hex / rgb / rgba / oklch color literals in BE Java sources so all
  token consumption goes through com.yeosal.api.theme.GeneratedTokens (auto-generated
  by ./gradlew generateTokens from FE/src/theme/tokens.json).

  Scope: applies to checkstyleMain only. The generated source dir (build/generated/**)
  and the test source set are excluded in BE/build.gradle.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Hex color literal (#RRGGBB or #RRGGBBAA or #RGB shorthand). -->
    <module name="RegexpSingleline">
        <property name="id" value="HexColorLiteralGuard"/>
        <property name="format" value="&quot;#[0-9A-Fa-f]{3,8}\b"/>
        <property name="message" value="Hex color literals are forbidden in BE Java sources. Use com.yeosal.api.theme.GeneratedTokens.* constants instead (Story 1.5 AC4, Arch 4.15)."/>
    </module>

    <!-- CSS-style rgb(...) literal. -->
    <module name="RegexpSingleline">
        <property name="id" value="RgbLiteralGuard"/>
        <property name="format" value="&quot;rgb\s*\("/>
        <property name="message" value="rgb(...) literals are forbidden in BE Java sources. Use com.yeosal.api.theme.GeneratedTokens.* constants instead (Story 1.5 AC4)."/>
    </module>

    <!-- CSS-style rgba(...) literal. -->
    <module name="RegexpSingleline">
        <property name="id" value="RgbaLiteralGuard"/>
        <property name="format" value="&quot;rgba\s*\("/>
        <property name="message" value="rgba(...) literals are forbidden in BE Java sources. Use com.yeosal.api.theme.GeneratedTokens.* constants instead (Story 1.5 AC4)."/>
    </module>

    <!-- CSS oklch(...) literal. -->
    <module name="RegexpSingleline">
        <property name="id" value="OklchLiteralGuard"/>
        <property name="format" value="&quot;oklch\s*\("/>
        <property name="message" value="oklch(...) literals are forbidden in BE Java sources. Use com.yeosal.api.theme.GeneratedTokens.* constants instead (Story 1.5 AC4)."/>
    </module>
</module>
