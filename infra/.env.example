POSTGRES_DB=yeosal
POSTGRES_USER=yeosal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
HTTP_PORT=8088
SERVER_SERVLET_CONTEXT_PATH=/yeolsal
YEOSAL_JWT_SECRET=replace-with-at-least-32-random-characters
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://api.rearleg.com/yeolsal/api/v1/auth/kakao/callback
KAKAO_MOBILE_REDIRECT_URI=yeosal://auth/kakao

# PostHog (Story 8.5). Leave YEOSAL_ANALYTICS_ENABLED=false in dev — a
# false flag routes the BE to NoOpAnalyticsService and skips the
# StartupConfigValidator analytics-consistency check.
YEOSAL_ANALYTICS_ENABLED=false
POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
# Official self-host installer wrapper (`infra/posthog.sh install`).
POSTHOG_DOMAIN=analytics.example.com
# Required 40-character commit from https://github.com/PostHog/posthog.
POSTHOG_UPSTREAM_REF=
POSTHOG_INSTALL_DIR=
