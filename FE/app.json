{
  "expo": {
    "name": "Yeosal",
    "slug": "yeosal",
    "scheme": "yeosal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F3E7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      "@sentry/react-native/expo"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.yeosal.mobile",
      "associatedDomains": ["applinks:yeolsal.app"]
    },
    "android": {
      "package": "app.yeosal.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#F8F3E7"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "yeolsal.app", "pathPrefix": "/join" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c44c026e-777e-4a47-9165-41688be39567"
      }
    },
    "owner": "rearleg"
  }
}
