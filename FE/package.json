{
  "name": "yeosal-fe",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-clone-referenced-element|@react-native-picker|react-native-svg|@shopify/flash-list|@tanstack/.*|@sentry(-internal)?/.*))"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}"
    ],
    "forceExit": true
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/query-async-storage-persister": "^5.100.6",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-query-persist-client": "^5.100.6",
    "expo": "~54.0.34",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.8",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.59.0"
  }
}
