EXPO_PUBLIC_API_BASE_URL=https://api.rearleg.com/yeolsal/api/v1

# Sentry — leave EXPO_PUBLIC_SENTRY_DSN empty in dev to disable.
# The DSN is public by design and safe to ship in the bundle.
# SENTRY_AUTH_TOKEN (used by the Sentry CLI to upload sourcemaps at build
# time) must NOT live here — store it in EAS Secrets and never commit it.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_APP_VERSION=0.1.0
